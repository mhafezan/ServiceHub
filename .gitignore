# Prevent credentials, generated output, private data, and local infrastructure state from entering Git.

.env
.env.*
!.env.example
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
node_modules/
dist/
*.db
*.sqlite*
.terraform/
*.tfstate*
*.tfvars
!*.tfvars.example
credentials*.json
service-account*.json
*.pem
*.key
private-data/
test-results/
playwright-report/
build/

